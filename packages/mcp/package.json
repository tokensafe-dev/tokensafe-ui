{
  "name": "@agent-dom/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for agent-dom runtime and AST operations",
  "type": "module",
  "bin": {
    "agent-dom-mcp": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@agent-dom/core": "workspace:*",
    "@agent-dom/observer": "workspace:*",
    "@agent-dom/patcher": "workspace:*",
    "@babel/parser": "^7.26.5",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.5",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
