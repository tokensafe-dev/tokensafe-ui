{
  "name": "tokensafe-ui",
  "version": "0.1.23",
  "license": "Apache-2.0",
  "description": "Deterministic, token-efficient frontend reactive micro-framework for AI coding agents",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "tokensafe-ui": "./bin/cli.js",
    "tokensafe-mcp": "./bin/mcp.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./observer": {
      "types": "./dist/observer.d.ts",
      "import": "./dist/observer.js",
      "require": "./dist/observer.cjs"
    },
    "./oumv": {
      "types": "./dist/oumv.d.ts",
      "import": "./dist/oumv.js",
      "require": "./dist/oumv.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react-client": {
      "types": "./dist/react-client.d.ts",
      "import": "./dist/react-client.js",
      "require": "./dist/react-client.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./patcher": {
      "types": "./dist/patcher.d.ts",
      "import": "./dist/patcher.js",
      "require": "./dist/patcher.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokensafe-dev/tokensafe-ui.git",
    "directory": "packages/tokensafe-ui"
  },
  "homepage": "https://github.com/tokensafe-dev/tokensafe-ui#readme",
  "bugs": {
    "url": "https://github.com/tokensafe-dev/tokensafe-ui/issues"
  },
  "keywords": [
    "tokensafe",
    "ai-agent",
    "reactive",
    "signals",
    "oumv",
    "agent-ui",
    "micro-framework"
  ],
  "dependencies": {
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.5",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.5",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tokensafe-ui/core": "workspace:*",
    "@tokensafe-ui/mcp": "workspace:*",
    "@tokensafe-ui/observer": "workspace:*",
    "@tokensafe-ui/oumv": "workspace:*",
    "@tokensafe-ui/patcher": "workspace:*",
    "@tokensafe-ui/vite": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
