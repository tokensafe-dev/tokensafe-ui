{
  "name": "@tokensafe-ui/observer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Semantic UI projector and compact accessibility state extractor (<150 tokens)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@tokensafe-ui/core": "workspace:*",
    "@babel/parser": "^7.26.5",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.5"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
