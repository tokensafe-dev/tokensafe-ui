{
  "name": "@tokensafe-ui/vite",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Vite plugin for tokensafe-ui JSX transformation and live DevServer RPC bridge",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@tokensafe-ui/core": "workspace:*",
    "@tokensafe-ui/observer": "workspace:*",
    "@tokensafe-ui/oumv": "workspace:*",
    "@tokensafe-ui/mcp": "workspace:*",
    "@tokensafe-ui/patcher": "workspace:*",
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.5",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.5"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
