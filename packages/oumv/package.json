{
  "name": "@tokensafe-ui/oumv",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "description": "Native OUMV Protocol Adapter for tokensafe-ui runtime",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react-client": {
      "types": "./dist/react-client.d.ts",
      "import": "./dist/react-client.js",
      "require": "./dist/react-client.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "require": "./dist/static.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@tokensafe-ui/core": "workspace:*",
    "@tokensafe-ui/observer": "workspace:*",
    "@tokensafe-ui/mcp": "workspace:*",
    "@babel/parser": "^7.26.2"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
